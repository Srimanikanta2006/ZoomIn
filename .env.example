# Web app (local default; set the deployed API URL in HF Spaces)
NEXT_PUBLIC_API_URL=http://localhost:7860
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_DOCUMENT_BUCKET=application-documents
NEXT_PUBLIC_DEMO_MODE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI
DEMO_MODE=false
WEB_ORIGIN=http://localhost:3000
PORT=7860
MOCK_ISSUER_LATENCY_MS=80
# Optional status injection for mock routes: not_started, in_progress, verified,
# discrepancy, inconclusive, unable_to_verify
MOCK_ISSUER_FAILURE_STATUS=
# Stable keyed graph pseudonyms for synthetic data; use a private random value outside demos.
GRAPH_HASH_SALT=preflight-synthetic-demo-only-rotate-for-real-data

# Optional Gemini Developer API key for the handbook rule proposal screen.
# The key is used only when configured; detected personal data is redacted first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
